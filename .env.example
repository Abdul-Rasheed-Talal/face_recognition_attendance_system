# ==============================================================================
# AI-Powered Face Recognition Attendance System - Configuration (.env)
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="College Lab Attendance System"
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Timezone (Institutional Local Timezone)
TIMEZONE=Asia/Karachi

# Database Configuration (SQLite for local development/benchmarking, PostgreSQL for production)
# SQLite: sqlite+aiosqlite:///./data/attendance.db
# PostgreSQL: postgresql+asyncpg://fras_user:fras_secure_password@localhost:5432/fras_db
DATABASE_URL=sqlite+aiosqlite:///./data/attendance.db
DB_ECHO=false

# Computer Vision & Inference Configuration
YUNET_MODEL_PATH=./models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=./models/face_recognition_sface_2021dec.onnx
CV_BACKEND=opencv_cpu
CV_DETECTION_CONFIDENCE_THRESHOLD=0.85
CV_NMS_THRESHOLD=0.30
CV_MIN_FACE_WIDTH=60
CV_LAPLACIAN_BLUR_THRESHOLD=60.0
CV_COSINE_SIMILARITY_THRESHOLD=0.363
CV_AMBIGUITY_MARGIN=0.080
CV_MULTI_FRAME_CONFIRMATION_COUNT=3
CV_MULTI_FRAME_WINDOW_SIZE=5
CV_TRACK_COOLDOWN_SECONDS=1800

# Camera Configuration
# RTSP URL or Device Index (e.g. 0 for local USB webcam, or rtsp://admin:pass@192.168.1.100:554/stream)
CAMERA_SOURCE=0
CAMERA_SOURCE_TYPE=webcam
CAMERA_RTSP_TRANSPORT=tcp
CAMERA_FPS=25
CV_PROCESSING_FPS=3
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_RECONNECT_INTERVAL_SECONDS=3.0

# Virtual Doorway Line-Crossing Calibration (Coordinates 0.0 to 1.0 relative)
# Direction: OUTSIDE (top or left) -> INSIDE (bottom or right)
ENTRY_LINE_START_X=0.10
ENTRY_LINE_START_Y=0.55
ENTRY_LINE_END_X=0.90
ENTRY_LINE_END_Y=0.55
ENTRY_DIRECTION_NORMAL_X=0.0
ENTRY_DIRECTION_NORMAL_Y=1.0

# Attendance Business Rules
DEFAULT_LATE_GRACE_MINUTES=15
AUTO_CLOSE_SESSION_HOURS=4

